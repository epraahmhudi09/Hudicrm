rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0 && value.size() <= 200;
    }

    function isOptionalString(value) {
      return value is string && value.size() <= 200;
    }

    function isValidStatus(value) {
      return value is string && (value == 'loyal' || value == 'normal');
    }

    // createdAt may be backdated (manual entry or bulk import of historical
    // records) but never set in the future.
    function isValidCreatedAt(value) {
      return value is timestamp && value <= request.time;
    }

    // bundleExpiry is optional (nullable) — no constraint on direction since
    // it represents a future renewal date as often as a past/lapsed one.
    function isValidBundleExpiry(value) {
      return value == null || value is timestamp;
    }

    // Optional — absent on customers who have never had a matched top-up,
    // and only ever written server-side by the SMS webhook (via a service
    // account, which bypasses these rules) using an atomic increment. Client
    // edits still need to be allowed to pass it through unchanged, same as
    // lastExpiryAlertSentFor below.
    function isValidTopupAmount(data) {
      return !('totalTopupAmount' in data) ||
        (data.totalTopupAmount is number && data.totalTopupAmount >= 0);
    }

    // References a bundles/{id} doc — nullable, and left unvalidated against
    // the bundles collection itself (Firestore rules can't cross-collection
    // existence-check affordably); an unresolvable ID just falls back to
    // the global amount match in the webhook, so a stale reference is safe.
    function isValidBundleId(value) {
      return value == null || (value is string && value.size() > 0 && value.size() <= 200);
    }

    function hasValidCustomerSchema(data) {
      return data.keys().hasOnly(
          ['name', 'mainPhone', 'backupPhone', 'bundle', 'status', 'bundleExpiry',
           'lastExpiryAlertSentFor', 'totalTopupAmount', 'bundleId', 'createdAt', 'updatedAt']) &&
        isNonEmptyString(data.name) &&
        isNonEmptyString(data.mainPhone) &&
        isOptionalString(data.backupPhone) &&
        isNonEmptyString(data.bundle) &&
        isValidStatus(data.status) &&
        isValidBundleExpiry(data.bundleExpiry) &&
        isValidTopupAmount(data) &&
        (!('bundleId' in data) || isValidBundleId(data.bundleId)) &&
        isValidCreatedAt(data.createdAt) &&
        data.updatedAt == request.time;
    }

    // lastExpiryAlertSentFor is stamped by the scheduled Cloud Function (via
    // the Admin SDK, which bypasses these rules) — clients never set it, but
    // must be allowed to pass it through unchanged on ordinary edits, since
    // `update` sees the full merged document here, not just changed fields.
    function hasValidCustomerUpdate(data) {
      return data.keys().hasOnly(
          ['name', 'mainPhone', 'backupPhone', 'bundle', 'status', 'bundleExpiry',
           'lastExpiryAlertSentFor', 'totalTopupAmount', 'bundleId', 'createdAt', 'updatedAt']) &&
        isNonEmptyString(data.name) &&
        isNonEmptyString(data.mainPhone) &&
        isOptionalString(data.backupPhone) &&
        isNonEmptyString(data.bundle) &&
        isValidStatus(data.status) &&
        isValidBundleExpiry(data.bundleExpiry) &&
        isValidBundleExpiry(data.lastExpiryAlertSentFor) &&
        isValidTopupAmount(data) &&
        (!('bundleId' in data) || isValidBundleId(data.bundleId)) &&
        data.createdAt == resource.data.createdAt &&
        data.updatedAt == request.time;
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasValidCustomerSchema(request.resource.data);
      allow update: if isSignedIn() && hasValidCustomerUpdate(request.resource.data);
      allow delete: if isSignedIn();

      // Append-only activity timeline for this customer. No update/delete —
      // it's a log, not editable state.
      function isValidActivityType(value) {
        return value is string &&
          (value == 'created' || value == 'status_change' || value == 'call' ||
           value == 'note' || value == 'updated' || value == 'topup');
      }

      function hasValidActivity(data) {
        return data.keys().hasOnly(['type', 'message', 'createdBy', 'createdAt']) &&
          isValidActivityType(data.type) &&
          isNonEmptyString(data.message) &&
          isNonEmptyString(data.createdBy) &&
          data.createdAt == request.time;
      }

      match /activities/{activityId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && hasValidActivity(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Per-user profile doc (avatar image + push notification token). Capped
    // well under Firestore's 1MiB document limit so a user can't stuff
    // arbitrarily large payloads in.
    function isValidUserProfile(data) {
      return data.keys().hasOnly(['photoDataUrl', 'fcmToken', 'updatedAt']) &&
        (!('photoDataUrl' in data) || (data.photoDataUrl is string && data.photoDataUrl.size() <= 400000)) &&
        (!('fcmToken' in data) || data.fcmToken is string) &&
        data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId &&
        isValidUserProfile(request.resource.data);
    }

    // Customers who owe the business money (tracked separately from the
    // regular customers collection — no status/bundle fields, just a
    // running amount owed).
    function hasValidDebtCustomerSchema(data) {
      return data.keys().hasOnly(['name', 'phone', 'backupPhone', 'amount', 'createdAt', 'updatedAt']) &&
        isNonEmptyString(data.name) &&
        isNonEmptyString(data.phone) &&
        isOptionalString(data.backupPhone) &&
        data.amount is number && data.amount >= 0 &&
        isValidCreatedAt(data.createdAt) &&
        data.updatedAt == request.time;
    }

    function hasValidDebtCustomerUpdate(data) {
      return data.keys().hasOnly(['name', 'phone', 'backupPhone', 'amount', 'createdAt', 'updatedAt']) &&
        isNonEmptyString(data.name) &&
        isNonEmptyString(data.phone) &&
        isOptionalString(data.backupPhone) &&
        data.amount is number && data.amount >= 0 &&
        data.createdAt == resource.data.createdAt &&
        data.updatedAt == request.time;
    }

    match /debtCustomers/{debtCustomerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasValidDebtCustomerSchema(request.resource.data);
      allow update: if isSignedIn() && hasValidDebtCustomerUpdate(request.resource.data);
      allow delete: if isSignedIn();
    }

    // Staff-managed pricing tiers ($ amount -> how long the bundle lasts).
    // Read by the SMS webhook (via a service account, which bypasses these
    // rules) to compute bundleExpiry on each top-up.
    function isValidDurationUnit(value) {
      return value is string && (value == 'hours' || value == 'days' || value == 'months');
    }

    function hasValidBundleSchema(data) {
      return data.keys().hasOnly(['name', 'amount', 'durationValue', 'durationUnit', 'createdAt', 'updatedAt']) &&
        isOptionalString(data.name) &&
        data.amount is number && data.amount > 0 &&
        data.durationValue is number && data.durationValue > 0 &&
        isValidDurationUnit(data.durationUnit) &&
        isValidCreatedAt(data.createdAt) &&
        data.updatedAt == request.time;
    }

    function hasValidBundleUpdate(data) {
      return data.keys().hasOnly(['name', 'amount', 'durationValue', 'durationUnit', 'createdAt', 'updatedAt']) &&
        isOptionalString(data.name) &&
        data.amount is number && data.amount > 0 &&
        data.durationValue is number && data.durationValue > 0 &&
        isValidDurationUnit(data.durationUnit) &&
        data.createdAt == resource.data.createdAt &&
        data.updatedAt == request.time;
    }

    match /bundles/{bundleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasValidBundleSchema(request.resource.data);
      allow update: if isSignedIn() && hasValidBundleUpdate(request.resource.data);
      allow delete: if isSignedIn();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
