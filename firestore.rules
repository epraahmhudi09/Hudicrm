rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Every rule below that scopes data by tenant reads the caller's own
    // users/{uid} doc once. Costs an extra read per rule evaluation, which
    // is fine at this app's scale, and fails closed (denies) if that doc
    // doesn't exist yet — matching the app's own "account not fully set up"
    // state for a user whose profile hasn't been provisioned.
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserTenantId() {
      return isSignedIn() ? callerProfile().tenantId : null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && callerProfile().isPlatformAdmin == true;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0 && value.size() <= 200;
    }

    function isOptionalString(value) {
      return value is string && value.size() <= 200;
    }

    function isValidStatus(value) {
      return value is string && (value == 'loyal' || value == 'normal');
    }

    // createdAt may be backdated (manual entry or bulk import of historical
    // records) but never set in the future.
    function isValidCreatedAt(value) {
      return value is timestamp && value <= request.time;
    }

    // bundleExpiry is optional (nullable) — no constraint on direction since
    // it represents a future renewal date as often as a past/lapsed one.
    function isValidBundleExpiry(value) {
      return value == null || value is timestamp;
    }

    // Optional — absent on customers who have never had a matched top-up,
    // and only ever written server-side by the SMS webhook (via a service
    // account, which bypasses these rules) using an atomic increment. Client
    // edits still need to be allowed to pass it through unchanged, same as
    // lastExpiryAlertSentFor below.
    function isValidTopupAmount(data) {
      return !('totalTopupAmount' in data) ||
        (data.totalTopupAmount is number && data.totalTopupAmount >= 0);
    }

    // References a bundles/{id} doc — nullable, and left unvalidated against
    // the bundles collection itself (Firestore rules can't cross-collection
    // existence-check affordably); an unresolvable ID just falls back to
    // the global amount match in the webhook, so a stale reference is safe.
    function isValidBundleId(value) {
      return value == null || (value is string && value.size() > 0 && value.size() <= 200);
    }

    function hasValidCustomerSchema(data) {
      return data.keys().hasOnly(
          ['tenantId', 'name', 'mainPhone', 'backupPhone', 'bundle', 'status', 'bundleExpiry',
           'lastExpiryAlertSentFor', 'last48hEscalationSentFor', 'totalTopupAmount', 'bundleId',
           'createdAt', 'updatedAt']) &&
        data.tenantId == getUserTenantId() &&
        isNonEmptyString(data.name) &&
        isNonEmptyString(data.mainPhone) &&
        isOptionalString(data.backupPhone) &&
        isNonEmptyString(data.bundle) &&
        isValidStatus(data.status) &&
        isValidBundleExpiry(data.bundleExpiry) &&
        isValidTopupAmount(data) &&
        (!('bundleId' in data) || isValidBundleId(data.bundleId)) &&
        isValidCreatedAt(data.createdAt) &&
        data.updatedAt == request.time;
    }

    // lastExpiryAlertSentFor / last48hEscalationSentFor are stamped by the
    // scheduled check (via a service account, which bypasses these rules) —
    // clients never set them, but must be allowed to pass them through
    // unchanged on ordinary edits, since `update` sees the full merged
    // document here, not just changed fields.
    function hasValidCustomerUpdate(data) {
      return data.keys().hasOnly(
          ['tenantId', 'name', 'mainPhone', 'backupPhone', 'bundle', 'status', 'bundleExpiry',
           'lastExpiryAlertSentFor', 'last48hEscalationSentFor', 'totalTopupAmount', 'bundleId',
           'createdAt', 'updatedAt']) &&
        data.tenantId == resource.data.tenantId &&
        isNonEmptyString(data.name) &&
        isNonEmptyString(data.mainPhone) &&
        isOptionalString(data.backupPhone) &&
        isNonEmptyString(data.bundle) &&
        isValidStatus(data.status) &&
        isValidBundleExpiry(data.bundleExpiry) &&
        (!('lastExpiryAlertSentFor' in data) || isValidBundleExpiry(data.lastExpiryAlertSentFor)) &&
        (!('last48hEscalationSentFor' in data) || isValidBundleExpiry(data.last48hEscalationSentFor)) &&
        isValidTopupAmount(data) &&
        (!('bundleId' in data) || isValidBundleId(data.bundleId)) &&
        data.createdAt == resource.data.createdAt &&
        data.updatedAt == request.time;
    }

    match /customers/{customerId} {
      allow read: if isSignedIn() && resource.data.tenantId == getUserTenantId();
      allow create: if isSignedIn() && hasValidCustomerSchema(request.resource.data);
      allow update: if isSignedIn() && resource.data.tenantId == getUserTenantId() &&
        hasValidCustomerUpdate(request.resource.data);
      allow delete: if isSignedIn() && resource.data.tenantId == getUserTenantId();

      // Append-only activity timeline for this customer. No update/delete —
      // it's a log, not editable state. Scoped via the parent customer's
      // tenantId rather than duplicating tenantId onto every activity doc.
      function isValidActivityType(value) {
        return value is string &&
          (value == 'created' || value == 'status_change' || value == 'call' ||
           value == 'note' || value == 'updated' || value == 'topup');
      }

      function hasValidActivity(data) {
        return data.keys().hasOnly(['type', 'message', 'createdBy', 'createdAt']) &&
          isValidActivityType(data.type) &&
          isNonEmptyString(data.message) &&
          isNonEmptyString(data.createdBy) &&
          data.createdAt == request.time;
      }

      function isOwnCustomer() {
        return get(/databases/$(database)/documents/customers/$(customerId)).data.tenantId == getUserTenantId();
      }

      match /activities/{activityId} {
        allow read: if isSignedIn() && isOwnCustomer();
        allow create: if isSignedIn() && isOwnCustomer() && hasValidActivity(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Per-user profile doc (avatar image, push notification token, and —
    // since the multi-tenant rollout — which tenant this login belongs to).
    // tenantId/isPlatformAdmin/email/disabled are only ever set by admin
    // API endpoints (service account, bypasses these rules); a client can
    // never create its own doc or change those four fields, only touch
    // photoDataUrl/fcmToken on an already-provisioned profile — otherwise a
    // signed-in user could grant themselves platform admin or hop tenants
    // by writing straight to Firestore from devtools.
    function isValidUserProfileUpdate(data) {
      return data.keys().hasOnly(
          ['photoDataUrl', 'fcmToken', 'tenantId', 'isPlatformAdmin', 'email', 'disabled', 'updatedAt']) &&
        (!('photoDataUrl' in data) || (data.photoDataUrl is string && data.photoDataUrl.size() <= 400000)) &&
        (!('fcmToken' in data) || data.fcmToken is string) &&
        (('tenantId' in data) == ('tenantId' in resource.data)) &&
        (!('tenantId' in data) || data.tenantId == resource.data.tenantId) &&
        (('isPlatformAdmin' in data) == ('isPlatformAdmin' in resource.data)) &&
        (!('isPlatformAdmin' in data) || data.isPlatformAdmin == resource.data.isPlatformAdmin) &&
        (('email' in data) == ('email' in resource.data)) &&
        (!('email' in data) || data.email == resource.data.email) &&
        (('disabled' in data) == ('disabled' in resource.data)) &&
        (!('disabled' in data) || data.disabled == resource.data.disabled) &&
        data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      allow create: if false;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUserProfileUpdate(request.resource.data);
      allow delete: if false;
    }

    // One doc per business. webhookToken gates that tenant's SMS automation
    // endpoints (checked server-side, not by these rules). Only platform
    // admins and that tenant's own signed-in users can read it (the tenant
    // reads their own token/URLs from their Settings page); only admin API
    // endpoints (service account) write it. list is split from get because
    // Firestore's list rule engine has to prove the condition holds for
    // every possible result up front — a per-document condition mixed into
    // the same OR as a document-independent one (isPlatformAdmin()) isn't
    // provable that way, so the unfiltered admin-page listing needs its own
    // list rule containing only the document-independent check.
    match /tenants/{tenantId} {
      allow get: if isPlatformAdmin() || (isSignedIn() && getUserTenantId() == tenantId);
      allow list: if isPlatformAdmin();
      allow write: if false;
    }

    // Customers who owe the business money (tracked separately from the
    // regular customers collection — no status/bundle fields, just a
    // running amount owed).
    function hasValidDebtCustomerSchema(data) {
      return data.keys().hasOnly(['tenantId', 'name', 'phone', 'backupPhone', 'amount', 'createdAt', 'updatedAt']) &&
        data.tenantId == getUserTenantId() &&
        isNonEmptyString(data.name) &&
        isNonEmptyString(data.phone) &&
        isOptionalString(data.backupPhone) &&
        data.amount is number && data.amount >= 0 &&
        isValidCreatedAt(data.createdAt) &&
        data.updatedAt == request.time;
    }

    function hasValidDebtCustomerUpdate(data) {
      return data.keys().hasOnly(['tenantId', 'name', 'phone', 'backupPhone', 'amount', 'createdAt', 'updatedAt']) &&
        data.tenantId == resource.data.tenantId &&
        isNonEmptyString(data.name) &&
        isNonEmptyString(data.phone) &&
        isOptionalString(data.backupPhone) &&
        data.amount is number && data.amount >= 0 &&
        data.createdAt == resource.data.createdAt &&
        data.updatedAt == request.time;
    }

    match /debtCustomers/{debtCustomerId} {
      allow read: if isSignedIn() && resource.data.tenantId == getUserTenantId();
      allow create: if isSignedIn() && hasValidDebtCustomerSchema(request.resource.data);
      allow update: if isSignedIn() && resource.data.tenantId == getUserTenantId() &&
        hasValidDebtCustomerUpdate(request.resource.data);
      allow delete: if isSignedIn() && resource.data.tenantId == getUserTenantId();
    }

    // Staff-managed pricing tiers ($ amount -> how long the bundle lasts).
    // Read by the SMS webhook (via a service account, which bypasses these
    // rules) to compute bundleExpiry on each top-up.
    function isValidDurationUnit(value) {
      return value is string && (value == 'hours' || value == 'days' || value == 'months');
    }

    function hasValidBundleSchema(data) {
      return data.keys().hasOnly(['tenantId', 'name', 'amount', 'durationValue', 'durationUnit', 'createdAt', 'updatedAt']) &&
        data.tenantId == getUserTenantId() &&
        isOptionalString(data.name) &&
        data.amount is number && data.amount > 0 &&
        data.durationValue is number && data.durationValue > 0 &&
        isValidDurationUnit(data.durationUnit) &&
        isValidCreatedAt(data.createdAt) &&
        data.updatedAt == request.time;
    }

    function hasValidBundleUpdate(data) {
      return data.keys().hasOnly(['tenantId', 'name', 'amount', 'durationValue', 'durationUnit', 'createdAt', 'updatedAt']) &&
        data.tenantId == resource.data.tenantId &&
        isOptionalString(data.name) &&
        data.amount is number && data.amount > 0 &&
        data.durationValue is number && data.durationValue > 0 &&
        isValidDurationUnit(data.durationUnit) &&
        data.createdAt == resource.data.createdAt &&
        data.updatedAt == request.time;
    }

    match /bundles/{bundleId} {
      allow read: if isSignedIn() && resource.data.tenantId == getUserTenantId();
      allow create: if isSignedIn() && hasValidBundleSchema(request.resource.data);
      allow update: if isSignedIn() && resource.data.tenantId == getUserTenantId() &&
        hasValidBundleUpdate(request.resource.data);
      allow delete: if isSignedIn() && resource.data.tenantId == getUserTenantId();
    }

    // Outbound SMS queue for the customer-facing 24h expiry reminder —
    // written by check-expiry and consumed by each tenant's Termux sender
    // script, both via a service account (bypasses these rules). Staff can
    // view their own tenant's queue for visibility, but never write to it
    // directly.
    match /outboundSms/{smsId} {
      allow read: if isSignedIn() && resource.data.tenantId == getUserTenantId();
      allow write: if false;
    }

    // One flat record per top-up transaction, written by the SMS webhook
    // (service account, bypasses these rules) alongside the cumulative
    // increment on the customer doc — lets Analytics query a date range
    // without a collection-group query over customers/*/activities.
    match /topups/{topupId} {
      allow read: if isSignedIn() && resource.data.tenantId == getUserTenantId();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
